Algoritmo PREGUNTA02
	Definir varEntero Como Entero
	Definir varDecimal Como Real
	Definir varCadena Como Cadena
	Definir varBooleano Como Lógico
	Escribir 'Ingrese un numero ENTERO: '
	Leer varEntero
	Escribir 'Ingrese un numero DECIMAL: '
	Leer varDecimal
	Escribir 'Ingrese una CADENA: '
	Leer varCadena
	Escribir 'Ingrese un BOOLEANO: '
	Leer varBooleano
	Escribir '=====El valor ingersado es: ', varEntero
	Escribir '=====El valor decimal es: ', varDecimal
	Escribir '=====El valor cadena es: ', varCadena
	Escribir '=====El valor bool es: ', varBooleano
FinAlgoritmo
